+        fn version(&self) -> ext::Version {
+            self.branches[self.checkout.id]
+        }
+        fn proj_mut(
+            &mut self,
+        ) -> ext::versioned::basic::Projection<(), &mut ext::versioned::basic::VersionedEGraph<()>>
